digraph "M3: DPDA for a balanced ledger" {
  rankdir=LR; bgcolor=white;
  node [shape=circle fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=10];
  start [shape=point width=0.08];
  "q0" [shape=doublecircle];
  "q1" [shape=circle];
  start -> "q0";
  "q0" -> "q1" [label="a, Z / CZ\lb, Z / DZ\l"];
  "q1" -> "q1" [label="a, C / CC\la, D / ε\lb, D / DD\lb, C / ε\l"];
  "q1" -> "q0" [label="ε, Z / Z\l"];
}